scalar UUID
scalar Time

type Project {
  id:            UUID!
  userID:        UUID!
  category:      String!
  name:          String!
  description:   String!
  currency:      String!
  goalAmount:    Int!
  currentAmount: Int!
  durationDays:  Int!
  status:        String!
  isBoosted:     Boolean!
  startedAt:     Time
  boostedUntil:  Time
}

input CreateProjectInput {
  userID:       UUID!
  category:     String!
  name:         String!
  description:  String!
  currency:     String!
  goalAmount:   Int!
  durationDays: Int!
}

input UpdateProjectInput {
  userID:       UUID!
  category:     String!
  name:         String!
  description:  String!
  currency:     String!
  goalAmount:   Int!
  durationDays: Int!
}

type Application {
  status:       String!
  rejectReason: String
  createdAt:    Time!
  assignedAt:   Time
  processedAt:  Time
  project:      Project
}

input ProjectsFilter {
  status:   String
  category: String
  search:   String
  sort:     String
  limit:    Int
  offset:   Int
}

type Query {
  project(id: UUID!):                           Project
  projects(filter: ProjectsFilter):             [Project!]!
  projectsByUser(userID: UUID!):                [Project!]!
  pendingApplications:                          [Application!]!
  myApplications(moderatorID: UUID!):           [Application!]!
  applicationByProject(projectID: UUID!):       Application
}

type Mutation {
  createProject(input: CreateProjectInput!):              Boolean!
  updateProject(id: UUID!, input: UpdateProjectInput!):   Boolean!
  takeApplication(id: UUID!, moderatorID: UUID!):         Boolean!
  approveProject(id: UUID!):                              Boolean!
  rejectProject(id: UUID!, reason: String!):              Boolean!
  boostProject(id: UUID!, userID: UUID!, promoCode: String!): Boolean!
}
